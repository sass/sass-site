<div class="code-example ui-tabs{% if code.canSplit %} can-split{% endif %}{% if code.isError %} error{% endif %}"{% if code.splitLocation %} style="--split-location: {{ code.splitLocation }}%"{% endif %}>
  <ul class="ui-tabs-nav ui-helper-reset ui-helper-clearfix">
    {%- if code.scss.size -%}
      {%- render 'code_examples/tab', name: 'SCSS', syntax: 'scss', id: exampleName, enabled: true -%}
    {%- endif -%}
    {%- if code.sass.size -%}
      {%- assign enabled = code.scss.size == 0 -%}
      {%- render 'code_examples/tab', name: 'Sass', syntax: 'sass', id: exampleName, enabled: enabled -%}
    {%- endif -%}
    {%- if code.css.size -%}
      {%- assign name = 'CSS' -%}
      {%- assign syntax = 'css' -%}
      {%- if code.isError -%}
        {%- assign name = 'Error' -%}
        {%- assign syntax = 'error' -%}
      {%- endif -%}
      {%- render 'code_examples/tab', name: name, syntax: syntax, id: exampleName, enabled: false -%}
    {%- endif -%}
  </ul>
  {%- if code.scss.size -%}
    {%- render 'code_examples/panel', name: 'SCSS Syntax', playgroundLink: playgroundLinks.scss, syntax: 'scss', id: exampleName, examples: code.scss, paddings: code.scssPaddings, enabled: true -%}
  {%- endif -%}
  {%- if code.sass.size -%}
    {%- assign enabled = code.scss.size == 0 -%}
    {%- render 'code_examples/panel', name: 'Sass Syntax', playgroundLink: playgroundLinks.sass, syntax: 'sass', id: exampleName, examples: code.sass, paddings: code.sassPaddings, enabled: enabled -%}
  {%- endif -%}
  {%- if code.css.size -%}
    {%- assign name = 'CSS Output' -%}
    {%- assign syntax = 'css' -%}
    {%- if code.isError -%}
      {%- assign name = 'Error Message' -%}
      {%- assign syntax = 'error' -%}
    {%- endif -%}
    {%- render 'code_examples/panel', name: 'CSS Output', syntax: syntax, id: exampleName, examples: code.css, paddings: code.cssPaddings, enabled: false, error: code.isError -%}
  {%- endif -%}
</div>
